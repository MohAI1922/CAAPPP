[Unit]
Description=VeriMath FastAPI Backend Service
After=network.target mosquitto.service

[Service]
Type=simple
User=pi
SupplementaryGroups=video
WorkingDirectory=/home/pi/verimath
EnvironmentFile=/home/pi/verimath/.env
Environment="PATH=/home/pi/.elan/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/pi/verimath/.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
