[Unit]
Description=VeriMath React Frontend Static Server
After=network.target verimath-backend.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/verimath/frontend
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/local/bin/serve -s build -l 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
