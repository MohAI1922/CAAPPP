# ─────────────────────────────────────────────────
# VeriMath Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────

# ── Gemini API (teacher dashboard AI summaries ONLY — not used in verification) ──
GOOGLE_API_KEY=your_google_ai_studio_key_here

# ── Firebase (Firestore telemetry sync) ──
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase_service_account.json
FIREBASE_PROJECT_ID=your_firebase_project_id

# ── Lean 4 ──
# Leave blank to auto-detect ~/.elan/bin/lean on Raspberry Pi / Linux
LEAN_BINARY_PATH=
LEAN_PROJECT_PATH=./lean/VeriMath
# Set to true on Raspberry Pi 4/5 to require real Lean 4 kernel verification (no SymPy fallback)
VERIMATH_STRICT_LEAN=false

# ── LLM (Qwen2.5-1.5B or 3B Instruct Q4_K_M GGUF on Raspberry Pi 4/5) ──
# Leave blank to auto-detect any downloaded .gguf in ./models/
LLM_MODEL_PATH=
LLM_N_CTX=4096
LLM_N_THREADS=4

# ── MQTT ──
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC=verimath/events

# ── Pipeline ──
MAX_FORMALIZATION_RETRIES=3
LEAN_TIMEOUT_SECONDS=45
DEMO_CACHE_PATH=./demo_cache.db

# ── App ──
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

# ── Camera & Handwriting OCR Connectors ──
# auto | rapidocr | tesseract | trocr | pix2tex | gemini_vision
OCR_BACKEND=auto
TROCR_MODEL_ID=microsoft/trocr-base-handwritten
TROCR_LOCAL_FILES_ONLY=true
