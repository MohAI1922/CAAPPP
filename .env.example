# ─────────────────────────────────────────────────
# VeriMath Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────

# ── Gemini API (teacher dashboard AI summaries ONLY — not used in verification) ──
GOOGLE_API_KEY=your_google_ai_studio_key_here

# ── Firebase (Firestore telemetry sync) ──
FIREBASE_SERVICE_ACCOUNT_PATH=/home/pi/verimath/secrets/firebase_service_account.json
FIREBASE_PROJECT_ID=your_firebase_project_id

# ── Lean 4 ──
LEAN_BINARY_PATH=/home/pi/.elan/bin/lean
LEAN_PROJECT_PATH=/home/pi/verimath/lean/VeriMath

# ── LLM (Phi-3 Mini GGUF) ──
LLM_MODEL_PATH=/home/pi/models/phi-3-mini-4k-instruct-q4_k_m.gguf
LLM_N_CTX=4096
LLM_N_THREADS=4

# ── MQTT ──
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC=verimath/events

# ── Pipeline ──
MAX_FORMALIZATION_RETRIES=3
LEAN_TIMEOUT_SECONDS=20
DEMO_CACHE_PATH=/home/pi/verimath/demo_cache.db

# ── App ──
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
